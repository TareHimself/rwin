include(default)

[settings]
compiler.cppstd=20

[options]
cairo/*:with_xlib=False
cairo/*:with_xlib_xrender=False
cairo/*:with_xcb=False
pango/*:with_cairo=True
pango/*:with_xft=False
wayland/*:shared=True
xkbcommon/*:with_x11=False

[replace_requires]
freetype/[>=2.13.2 <3]: freetype/2.13.2
freetype/[>=2.13 <3]: freetype/2.13.2
fontconfig/[>=2.15 <3]: fontconfig/2.15.0
glib/[^2.78]: glib/2.78.3
